{
  "name": "@amazon-trade/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --target node20 --clean --noExternal @amazon-trade/shared",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "openapi": "tsx --env-file-if-exists=../../.env src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@amazon-trade/shared": "*",
    "@electric-sql/pglite": "^0.5.15",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.15",
    "nodemailer": "^8.0.2",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.2",
    "zod": "^4.6.7",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
