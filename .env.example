# ---- API (apps/api) ----
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# URL pública do frontend (CORS, links em e-mails)
WEB_ORIGIN=http://localhost:3000
# URL pública da API usada em links (downloads assinados, webhook exibido no backoffice). Em dev passa pelo proxy do Next.
PUBLIC_API_URL=http://localhost:3000/api
# pg (PostgreSQL, ex.: docker compose up -d) | pglite (embarcado, sem Docker)
DB_DRIVER=pglite
DATABASE_URL=postgres://amazon:amazon@localhost:5432/amazon_trade
PGLITE_DATA_DIR=./.data/pglite
# Segredos (trocar em produção!). Mínimo 32 caracteres.
JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
# 32 bytes em base64 (AES-256-GCM p/ segredos de integrações): openssl rand -base64 32
SECRETS_MASTER_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLTAxMjM0NTY3ODlhYmM=
# Armazenamento de documentos (local | s3 futuramente)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# E-mail (console imprime no log; smtp envia)
MAIL_DRIVER=console
MAIL_FROM="Amazon Trade <no-reply@amazontrade.local>"
SMTP_URL=
# Precificação padrão por serviço quando não há config no banco: TABLE | PARTNER_API
PRICING_DEFAULT_MODE=TABLE
# Worker de integrações (outbox)
INTEGRATION_WORKER_ENABLED=true
INTEGRATION_WORKER_INTERVAL_MS=3000

# ---- Web (apps/web) ----
# Para onde o proxy /api/* encaminha
API_INTERNAL_URL=http://localhost:4000

# ---- Seed em produção (só cria o administrador se ambos estiverem definidos) ----
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
